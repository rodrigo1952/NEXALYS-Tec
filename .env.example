# Modelo del archivo .env de NEXALYS Tec (este SÍ se sube a GitHub; el .env NO).
# Para crear tu .env con una clave al azar:   python config/crear_env.py
# En el servidor:                              python config/crear_env.py --produccion

# --- Obligatorios -----------------------------------------------------------------
# Clave con la que Django firma sesiones y enlaces de correo. Larga, al azar y secreta.
SECRET_KEY=
# True solo en tu PC. En el servidor: False (sin esto, cualquiera ve los errores con detalles).
DEBUG=True
# Dominios desde los que se abre la página, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1
# Dirección completa del sitio, sin / al final (enlaces que se comparten por WhatsApp).
SITIO_URL=http://127.0.0.1:8000

# --- Seguridad --------------------------------------------------------------------
# Dirección secreta del Django Admin (termina en /). Si falta, queda en admin/.
DJANGO_ADMIN_URL=admin/
# Cabecera con la IP real del visitante (para el límite de intentos).
# En tu PC: REMOTE_ADDR (o déjalo vacío). En PythonAnywhere: HTTP_X_REAL_IP
IP_CABECERA=
# Correo que recibe el aviso cuando la página falla (separa varios con comas). Funciona cuando haya
# correo real configurado; mientras tanto, los errores se ven en la consola: Control → Errores.
CORREO_ADMIN=

# --- Privacidad (Ley 29733): datos del responsable para la política -------------------
# Mientras falten, la consola del administrador lo avisa en «Tareas pendientes».
PRIVACIDAD_TITULAR=
# DNI (persona natural) o RUC (empresa)
PRIVACIDAD_DOCUMENTO=
PRIVACIDAD_DIRECCION=
# Correo donde las personas piden sus derechos (también llegan por el formulario de la página)
PRIVACIDAD_CORREO=
# Nombre del banco de datos y su código de inscripción en el Registro Nacional de Protección de Datos
PRIVACIDAD_BANCO_DATOS=
# País del servidor del hosting, p. ej.: PythonAnywhere (Estados Unidos)
PRIVACIDAD_SERVIDOR=
# Correo de ayuda que se muestra en «Ayuda y soporte»
CORREO_SOPORTE=soporte@nexalys.pe

# --- Solo con DEBUG=False (servidor con HTTPS) ---------------------------------------
# Las cookies de sesión viajan solo por HTTPS. Pon False solo para probar DEBUG=False en tu PC.
COOKIES_SEGURAS=True
# Segundos que el navegador recuerda «este sitio va siempre con HTTPS». Empieza bajo (1 hora)
# y súbelo a 31536000 (1 año) cuando confirmes que todo funciona con HTTPS.
HSTS_SEGUNDOS=3600
# En PythonAnywhere, HTTPS se fuerza con el interruptor «Force HTTPS» de la pestaña Web.
# Pon True solo si tu hosting envía la cabecera X-Forwarded-Proto (si no, la página entra en un bucle).
PROXY_HTTPS=False
FORZAR_HTTPS=False
